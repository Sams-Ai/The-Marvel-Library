# Local-only development (auth_setup.py writes a private .env.local).
# Copy no secret values into this template.
DATABASE_PATH=./marvel_library.sqlite3
WEB_USER=operator
# WEB_PASSWORD_HASH is PBKDF2-SHA256 in salt_hex$hash_hex form; use auth_setup.py.
# WEB_SESSION_KEY must be a long random value; auth_setup.py creates it locally.
WEB_HOST=127.0.0.1
WEB_PORT=8080
COOKIE_SECURE=0

# Future production only — do not enable until separately reviewed.
# Use the host's secret manager; never commit actual values.
# DATABASE_URL=
# WEB_PASSWORD_HASH=
# WEB_SESSION_KEY=
# COOKIE_SECURE=1
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# META_APP_ID=
# META_APP_SECRET=
# META_LIVE_PUBLISH_ENABLED=false
# ALERT_WEBHOOK_URL=
